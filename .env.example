# Copy to .env and fill in (or run "npm run setup", which writes this for you).
# Keep .env private: it holds your tokens. Fill in at least one alert channel.

# Home Assistant (push to the HA companion app on your iPhone)
#   HA_URL:            how this computer reaches HA, e.g. http://homeassistant.local:8123
#   HA_TOKEN:          HA → your profile → Security → Long-lived access tokens → Create token
#   HA_NOTIFY_SERVICE: Developer tools → Actions → search "notify.mobile_app" → the part after "notify."
HA_URL=
HA_TOKEN=
HA_NOTIFY_SERVICE=

# Optional: ntfy (https://ntfy.sh). Install the ntfy app and subscribe to the same hard-to-guess topic.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# Optional: Telegram. Create a bot with @BotFather; message it, then get your chat ID from
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
